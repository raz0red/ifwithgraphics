# Emscripten build output
wasm/build/

# Generated headers (produced by Makefile targets)
wasm/frotz/src/common/defs.h
wasm/frotz/src/common/hash.h

# Deployed WASM artifacts
builder/wasm/
player/src/wasm/
player/wasm/

# Source npm
player/src/node_modules/
player/src/dist/
player/node_modules/

# Build output
dist/
frotz-ws/bin/
frotz-ws/frotz/bin/
tools/explorer/bin/
tools/explorer/frotz/bin/
tools/imagegen/imagegen
wasm/ztools/source/infodump
wasm/ztools/source/infodump_linux
wasm/ztools/source/txd

# Explorer intermediate artifacts
bfs-saves/
# Per-run explorer console logs (run1.out, seed2.out, runFix1.out, ...). These
# accumulate a dozen or more per game while a walkthrough is being tuned, and
# unlike bfs.json they are throwaway. Note *.log below does not cover them.
tools/explorer/games/*/*.out
# Stray probe binaries built outside tools/explorer/bin/.
tools/explorer/probe

# Scratch/working files
# Globbed rather than enumerated: tmp/ through tmp4/ were listed one by one and
# tmp5/ then showed up untracked, leaving a story file visible to `git add`.
tmp*/
tools/explorer/tmp_*.txt
# Anchored: only the root scratch copy. Each game's recorded rooms
# (tools/explorer/games/<name>/bfs.json) is a tracked dataset.
/bfs.json
bz.z5
# Per-game explorer verification output, for any game rather than just the
# first one that produced it.
tools/explorer/games/*/verify/

# Claude memory / session files
.claude/

# OS / editor
.DS_Store
Thumbs.db
*.log
*.code-workspace
